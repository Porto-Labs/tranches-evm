{
  "name": "@porto/tranches",
  "description": "Porto Tranches - Fixed-rate senior/junior tranching mechanism (SY → srSY + jrSY)",
  "license": "MIT",
  "version": "0.1.0",
  "homepage": "https://github.com/porto-finance/tranches-evm",
  "keywords": [
    "porto",
    "tranches",
    "fixed-rate",
    "defi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/porto-finance/tranches-evm"
  },
  "files": [
    "contracts",
    "typechain-types",
    "build/artifacts/contracts/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.0.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.5.0",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "size": "hardhat size-contracts",
    "clean": "hardhat clean",
    "fcompile": "yarn clean && yarn compile",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3",
    "ethers": "^5.7.2"
  }
}
